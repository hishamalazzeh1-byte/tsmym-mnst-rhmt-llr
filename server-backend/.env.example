# ==============================================================================
# خادم منصة «رحمة» — متغيرات الإنتاج
# ==============================================================================
# هذا الملف نموذج مرجعي فقط. لا تضع الأسرار هنا ولا ترفعه إلى Git.
# الأسرار تُضبط في لوحة تحكم خدمة الاستضافة (Vercel / Railway / Fly.io).
#
# توليد أسرار عشوائية:
#   node server-backend/env.js
# =============================================================================

NODE_ENV="production"
PORT="5000"

# ── قاعدة البيانات (إلزامي في الإنتاج) ───────────────────────────────────────
# Neon / Supabase / RDS — رابط PostgreSQL كامل مع كلمة المرور.
# رابط سحابي مكتمل: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=""
# اجعلها false فقط إذا كانت القاعدة محلية (تطوير)
DATABASE_SSL="true"
DATABASE_POOL_MAX="10"

# ── الأسرار (إلزامي — 32 حرفاً على الأقل) ───────────────────────────────────
# غيّرها لكل بيئة. لا تُشاركها ولا ترسلها في Slack/البريد.
JWT_SECRET=""
# مفتاح تشفير رموز الجلسات (AES-256-GCM). تغييره يُبطل كل الرموز القائمة.
SESSION_CODE_KEY=""

# ── الصلاحيات ───────────────────────────────────────────────────────────────
# رقم المدير (11 رقماً يبدأ بـ 01). غيّره فوراً عن 01000000000.
# من يسجّل بهذا الرقم يُرقّى إلى admin تلقائياً عند أول تأكيد للرمز.
ADMIN_PHONE=""

# نطاقات الواجهة المسموح لها بالوصول (مفصولة بفواصل، بدون مسافة)
CORS_ORIGINS="https://rahma-health.com,https://www.rahma-health.com"

# ── مزوّد الرسائل (إلزامي — لا يُقبل CONSOLE في الإنتاج) ───────────────────
# القيم: TWILIO أو SMS_MISR
SMS_PROVIDER="TWILIO"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# SMS Misr (بديل محلي)
# SMS_MISR_USERNAME=""
# SMS_MISR_PASSWORD=""
# SMS_MISR_SENDER="Rahma"
# SMS_MISR_ENVIRONMENT="1"

# ── misc ────────────────────────────────────────────────────────────────────
# مسار بيانات JSON (تطوير فقط — يُتجاهل عند ضبط DATABASE_URL)
# RAHMA_DATA_DIR="server-backend/data"