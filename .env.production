# ==============================================================================
# منصة «رحمة» - ملف متغيرات الإنتاج (Production Environment)
# ==============================================================================

# 1. إعدادات الهوية والاسم والدومين
NEXT_PUBLIC_APP_NAME="رحمة"
NEXT_PUBLIC_APP_TAGLINE="التمريض والإسعاف المنزلي في مصر"
NEXT_PUBLIC_APP_DESC="منصة ذكية للرعاية التمريضية والإسعافية المنزلية في جميع محافظات مصر تربط المريض بأقرب ممرض معتمد."
NEXT_PUBLIC_APP_DOMAIN="rahma-health.com"
NEXT_PUBLIC_APP_URL="https://rahma-health.com"

# 2. بيانات التواصل وخدمة العملاء
NEXT_PUBLIC_SUPPORT_PHONE="16123"
NEXT_PUBLIC_SUPPORT_EMAIL="support@rahma-health.com"

# 3. النظام المالي والعمولات (خصم تلقائي في الخلفية)
NEXT_PUBLIC_PLATFORM_COMMISSION="10"
NEXT_PUBLIC_NURSE_INITIAL_CREDIT="100"

# 4. بيئة التشغيل
NODE_ENV="production"
