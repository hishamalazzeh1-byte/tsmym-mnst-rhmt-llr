# ==============================================================================
# منصة «رحمة» - ملف متغيرات البيئة وإعدادات النشر (Production Environment)
# انسخ هذا الملف إلى .env.local للتطوير المحلي، أو اضبطه في إعدادات الاستضافة (Vercel / VPS / Cloud)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الهوية والاسم والدومين (Branding & Custom Domain)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="رحمة"
NEXT_PUBLIC_APP_TAGLINE="التمريض والإسعاف المنزلي في مصر"
NEXT_PUBLIC_APP_DESC="منصة ذكية للرعاية التمريضية والإسعافية المنزلية في جميع محافظات مصر"
NEXT_PUBLIC_APP_DOMAIN="rahma-health.com"
NEXT_PUBLIC_APP_URL="https://rahma-health.com"

# ------------------------------------------------------------------------------
# 2. بيانات التواصل وخدمة العملاء (Support & Contacts)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_PHONE="16123"
NEXT_PUBLIC_SUPPORT_EMAIL="support@rahma-health.com"

# ------------------------------------------------------------------------------
# 3. النظام المالي والعمولات (خصم تلقائي في الخلفية)
# ------------------------------------------------------------------------------
# عمولة التطبيق للشركة لكل جلسة منتهية (بالجنيه المصري)
NEXT_PUBLIC_PLATFORM_COMMISSION="10"
# الرصيد المبدئي المجاني الممنوح لكل ممرض جديد عند التسجيل (يكفي لـ 10 جلسات)
NEXT_PUBLIC_NURSE_INITIAL_CREDIT="100"

# ------------------------------------------------------------------------------
# 4. الخادم وقاعدة البيانات المحلية (JSON files في server-backend/data)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"
JWT_SECRET=""
PORT="5000"
ADMIN_PHONE=""
SMS_PROVIDER=""

# ------------------------------------------------------------------------------
# 5. الذكاء الاصطناعي - الفرز الطبي الذكي (Google Gemini / Vercel AI SDK)
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. خادم البريد والإشعارات (SMTP / Email Service)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@rahma-health.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="رحمة للرعاية الصحية <no-reply@rahma-health.com>"

# ------------------------------------------------------------------------------
# 7. بيئة التشغيل
# ------------------------------------------------------------------------------
NODE_ENV="production"
